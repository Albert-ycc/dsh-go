#!/usr/bin/env node
// CLI：status pair revoke halt resume target logs doctor。管理口是 127.0.0.1 明文口 + control.token。
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import net from 'node:net';
import http from 'node:http';
import { spawn, spawnSync } from 'node:child_process';
import { X509Certificate } from 'node:crypto';

const home = process.env.DSH_RELAY_HOME ?? path.join(os.homedir(), '.dsh-relay');
const port = Number(process.env.DSH_RELAY_PORT ?? 8731);
const ctlPort = Number(process.env.DSH_RELAY_CTL_PORT ?? port + 1);
const logDir = process.env.DSH_RELAY_LOG_DIR ?? path.join(os.homedir(), 'Library', 'Logs', 'dsh-relay');
const label = process.env.DSH_RELAY_LABEL ?? 'local.dsh-relay';
// doctor 两个常见标签都查：仓库默认与此前文档里的 com.albert.dsh-relay
const labels = [...new Set([label, 'local.dsh-relay', 'com.albert.dsh-relay'])];
const hdcBin = process.env.HDC_BIN ?? path.join(os.homedir(), '.local', 'bin', 'hdc');

function ctl(method, p, body) {
  let token;
  try {
    token = fs.readFileSync(path.join(home, 'control.token'), 'utf8').trim();
  } catch {
    return Promise.reject(new Error(`control.token not found in ${home}; has the service ever started?`));
  }
  return new Promise((resolve, reject) => {
    const data = body ? JSON.stringify(body) : null;
    const req = http.request(
      { host: '127.0.0.1', port: ctlPort, path: p, method, headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json', ...(data ? { 'content-length': Buffer.byteLength(data) } : {}) } },
      (res) => {
        const c = [];
        res.on('data', (d) => c.push(d));
        res.on('end', () => {
          try {
            const j = JSON.parse(Buffer.concat(c).toString());
            res.statusCode >= 400 ? reject(new Error(j.error?.message ?? `HTTP ${res.statusCode}`)) : resolve(j);
          } catch (e) { reject(e); }
        });
      },
    );
    req.on('error', (e) => reject(new Error(`service not reachable on 127.0.0.1:${ctlPort} (${e.code})`)));
    if (data) req.write(data);
    req.end();
  });
}

const run = (cmd, args, timeout = 5000) => spawnSync(cmd, args, { encoding: 'utf8', timeout, stdio: ['ignore', 'pipe', 'pipe'] });

async function doctor() {
  const rows = [];
  const add = (name, ok, detail, warn = false) => rows.push({ name, ok, detail, warn });
  add('node', Number(process.versions.node.split('.')[0]) >= 22, process.version);
  const v = run(hdcBin, ['-v']);
  add('hdc binary', v.status === 0, v.status === 0 ? v.stdout.trim() : `${hdcBin} not runnable`);
  const lt = run(hdcBin, ['list', 'targets', '-v']);
  add('hdc server / targets', lt.status === 0 && !/\[Fail\]/.test(lt.stdout), lt.stdout.trim().replace(/\n/g, ' | ') || lt.stderr.trim());
  try {
    const c = new X509Certificate(fs.readFileSync(path.join(home, 'tls', 'cert.pem')));
    const days = Math.floor((new Date(c.validTo) - Date.now()) / 86400000);
    add('certificate', days > 30, `expires in ${days} days`);
  } catch { add('certificate', false, 'not generated yet (created on first service start)'); }
  let status = null;
  try { status = await ctl('GET', '/ctl/status'); } catch (e) { add('service (ctl port)', false, e.message); }
  if (status) {
    add('service (ctl port)', true, `v${status.version}, ${status.listeners.length} listeners`);
    for (const l of status.listeners) add(`listener ${l}`, true, 'bound');
    add('halt flag', !status.halted, status.halted ? 'HALTED, run: dsh-relay resume' : 'not halted');
    add('paired tokens', status.tokens.length > 0, status.tokens.length > 0 ? `${status.tokens.length} paired` : 'none paired, no phone can connect: run dsh-relay pair', true);
    // 绑定设备是否真能连上：让服务当场连一次（hdc 服务能列出设备不等于手机能被操作）
    try {
      const pr = await ctl('POST', '/ctl/probe');
      const d = pr.device;
      add('bound device online', d.state === 'ok', d.state === 'ok' ? `${d.via} ${d.target} ${d.model ?? ''}`.trim() : `state=${d.state}${pr.error ? ` (${pr.error})` : ''}; check USB, wireless debugging switch and port (dsh-relay target set <ip:port>)`);
    } catch (e) { add('bound device online', false, e.message); }
  }
  const pm = run('pmset', ['-g']);
  const sleep = /^\s*sleep\s+(\d+)/m.exec(pm.stdout)?.[1];
  add('pmset sleep', sleep === '0', sleep === '0' ? 'sleep 0' : `sleep ${sleep}: Mac sleep takes the relay offline`);
  const loaded = labels.find((l) => run('launchctl', ['list', l]).status === 0);
  add('launchd job', !!loaded, loaded ? `${loaded} loaded` : `not loaded (tried ${labels.join(', ')})`);
  try { fs.mkdirSync(logDir, { recursive: true }); fs.accessSync(logDir, fs.constants.W_OK); add('log dir', true, logDir); } catch { add('log dir', false, logDir); }
  const ping = await new Promise((r) => {
    const s = net.connect(port, '127.0.0.1');
    s.on('connect', () => { s.destroy(); r(true); });
    s.on('error', () => r(false));
  });
  add(`port ${port} in use`, ping === !!status, ping ? (status ? 'held by dsh-relay' : 'held by ANOTHER process') : 'free');
  let bad = 0;
  for (const r of rows) { if (!r.ok && !r.warn) bad++; console.log(`${r.ok ? 'ok  ' : r.warn ? 'warn' : 'FAIL'}  ${r.name}: ${r.detail}`); }
  return bad ? 1 : 0;
}

const [cmd, ...args] = process.argv.slice(2);
try {
  switch (cmd) {
    case 'status': {
      const s = await ctl('GET', '/ctl/status');
      console.log(JSON.stringify(s, null, 2));
      break;
    }
    case 'pair': {
      const r = await ctl('POST', '/ctl/pair');
      console.log(`pairing code: ${r.code}  (valid 5 minutes, one use)`);
      console.log(`addresses: ${r.addresses.join('  ') || '(none)'}`);
      console.log(`certificate sha256: ${r.fingerprint}`);
      break;
    }
    case 'revoke':
      if (!args[0] || (args[0] !== 'all' && !/^[0-9a-f]{6}$/.test(args[0]))) throw new Error('usage: dsh-relay revoke <6-hex id from status|all>');
      console.log(`revoked: ${(await ctl('POST', '/ctl/revoke', { id: args[0] })).revoked}`);
      break;
    case 'halt':
      fs.writeFileSync(path.join(home, 'HALT'), String(Date.now()), { mode: 0o600 });
      try { await ctl('POST', '/ctl/halt'); } catch {}
      console.log('halted');
      break;
    case 'resume':
      fs.rmSync(path.join(home, 'HALT'), { force: true });
      try { await ctl('POST', '/ctl/resume'); } catch {}
      console.log('resumed');
      break;
    case 'target':
      if (args[0] === 'set') console.log(JSON.stringify(await ctl('POST', '/ctl/target', { addr: args[1] })));
      else if (args[0] === 'auto') console.log(JSON.stringify(await ctl('POST', '/ctl/target', { addr: null })));
      else console.log(JSON.stringify((await ctl('GET', '/ctl/status')).device));
      break;
    case 'logs': {
      const f = path.join(logDir, 'relay.log');
      spawn('tail', args[0] === '-f' ? ['-n', '50', '-f', f] : ['-n', '50', f], { stdio: 'inherit' });
      break;
    }
    case 'doctor':
      process.exitCode = await doctor();
      break;
    default:
      console.log('usage: dsh-relay status|pair|revoke <id|all>|halt|resume|target show|set <ip:port>|auto|logs [-f]|doctor');
      process.exitCode = cmd ? 2 : 0;
  }
} catch (e) {
  console.error(`dsh-relay: ${e.message}`);
  process.exitCode = 1;
}
