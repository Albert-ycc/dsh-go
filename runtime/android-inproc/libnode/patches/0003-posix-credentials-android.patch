# 来源：Termux packages/nodejs 的 src-node_internals.h。
# 为什么：24.22.1 在 Android 不定义 NODE_IMPLEMENTS_POSIX_CREDENTIALS，process.getuid/geteuid 等缺失，引擎的 dsh-spill-local 会少一道临时目录属主校验。
--- a/src/node_internals.h
+++ b/src/node_internals.h
@@ -326,9 +326,9 @@
 
 // Functions defined in node.cc that are exposed via the bootstrapper object
 
-#if defined(__POSIX__) && !defined(__ANDROID__) && !defined(__CloudABI__)
+#if defined(__POSIX__) && !defined(__CloudABI__)
 #define NODE_IMPLEMENTS_POSIX_CREDENTIALS 1
-#endif  // defined(__POSIX__) && !defined(__ANDROID__) && !defined(__CloudABI__)
+#endif  // defined(__POSIX__) && !defined(__CloudABI__)
 
 namespace credentials {
 bool SafeGetenv(const char* key, std::string* text, Environment* env = nullptr);
